# Copy to .env.local for local development (never commit real secrets).

# --- Required -------------------------------------------------------------
# Postgres connection string. Local: run `npm run dev:db` and use the value it prints.
# Production: the "pooled" connection string from Neon.
DATABASE_URL=postgres://inphinity:inphinity@localhost:54329/inphinity

# At least 32 random characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Production only ------------------------------------------------------
# The public address of your site (used for the same-origin security check).
# APP_URL=https://inphinity.vercel.app

# File storage (any S3-compatible bucket: Cloudflare R2, Backblaze B2, Supabase Storage...).
# Leave all of these empty to store files on local disk (development only).
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=inphinity-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
